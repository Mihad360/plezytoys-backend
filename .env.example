# ==============================================================================
# SHIFTPOINT BACKEND — ENVIRONMENT CONFIGURATION
# ==============================================================================
# NOTE FOR DEVELOPER / DEPLOYMENT:
# In development, you can use local/mock values or your own developer test keys.
# Below each section is marked with [CLIENT REQUIRED FOR PRODUCTION] where applicable.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
LOCAL_URL=http://localhost:5000
APP_NAME=ShiftPoint

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION [CLIENT REQUIRED FOR PRODUCTION]
# ------------------------------------------------------------------------------
# Production: Client's MongoDB Atlas cluster connection string.
# Development: Local MongoDB or free MongoDB Atlas cluster.
DATABASE_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/shiftpoint?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. JWT AUTHENTICATION SECRETS
# ------------------------------------------------------------------------------
# Random 64+ char strings for signing access & refresh tokens (generate via `openssl rand -hex 32`)
JWT_SECRET_KEY=your_jwt_secret_key_here_change_in_production
JWT_REFRESH_KEY=your_jwt_refresh_key_here_change_in_production
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=30d

# ------------------------------------------------------------------------------
# 4. INITIAL SEED ACCOUNTS (Default Admin Credentials)
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@shiftpoint.com
ADMIN_PASS=123456
SUPER_ADMIN_EMAIL=superadmin@shiftpoint.com
SUPER_ADMIN_PASS=123456

# ------------------------------------------------------------------------------
# 5. MAPS & LOCATION SERVICES [CLIENT REQUIRED FOR PRODUCTION]
# ------------------------------------------------------------------------------
# What it's for:
# - Geocoding addresses when creating Locations and Customers
# - Address autocompletion on Dashboard
# - Interactive map rendering & radius geofencing for GPS clock-in verification
# What to ask client: Google Cloud Console -> Google Maps Platform API Key
# (Enabled APIs: Maps JavaScript API, Geocoding API, Places API)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
# Alternative if Mapbox is preferred:
MAPBOX_ACCESS_TOKEN=your_mapbox_token_here

# ------------------------------------------------------------------------------
# 6. MEDIA & EVIDENCE STORAGE (Cloudinary or AWS S3) [CLIENT REQUIRED FOR PRODUCTION]
# ------------------------------------------------------------------------------
# What it's for:
# - Guard task photo/video evidence uploads from Mobile App
# - Incident report photos & attachment files
# - Employee security certificates, First Aid passes, licenses (PDF / JPG)
# - Company branding logos and user profile avatars
# What to ask client: Cloudinary Account credentials OR AWS S3 Bucket credentials
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER_NAME=shiftpoint_uploads

# ------------------------------------------------------------------------------
# 7. FIREBASE CLOUD MESSAGING (FCM) — PUSH NOTIFICATIONS [CLIENT REQUIRED FOR PRODUCTION]
# ------------------------------------------------------------------------------
# What it's for:
# - Instant push notifications to guards on Mobile App (Android & iOS)
# - Alerts: New Task Assigned, Patrol Checkpoint Reminder, GPS Anomaly, Report Approved
# What to ask client: Firebase Console -> Project Settings -> Service Accounts -> Generate Private Key (JSON)
FIREBASE_TYPE=service_account
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY_ID=your_firebase_private_key_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your_project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your_firebase_client_id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/your_client_email
FIREBASE_UNIVERSE_DOMAIN=googleapis.com

# ------------------------------------------------------------------------------
# 8. EMAIL SERVICE (SMTP / SendGrid / SES) [CLIENT REQUIRED FOR PRODUCTION]
# ------------------------------------------------------------------------------
# What it's for:
# - Sending 6-digit OTP verification codes for Forgot Password
# - Employee onboarding / invite emails
# - Customer report digest delivery
# What to ask client: Corporate SMTP credentials or SendGrid / AWS SES API credentials
NODE_MAIL_EMAIL=notifications@shiftpoint.com
NODE_MAIL_PASS=your_email_smtp_app_password
NODE_MAIL_EMAIL_CLIENT=support@shiftpoint.com

# ------------------------------------------------------------------------------
# 9. PAYMENT & SAAS SUBSCRIPTIONS (Stripe) [CLIENT REQUIRED FOR PRODUCTION]
# ------------------------------------------------------------------------------
# What it's for:
# - Super Admin SaaS subscription billing for Company Admins
# - Payment history & invoice PDF generation
# What to ask client: Stripe Dashboard -> Developers -> API Keys & Webhook secret
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ------------------------------------------------------------------------------
# 10. AI ASSISTANT & KNOWLEDGE SOURCES [CLIENT REQUIRED FOR PRODUCTION]
# ------------------------------------------------------------------------------
# What it's for:
# - Answering guards' operational procedure questions in the mobile app
# - Ingesting company handbook & SOP knowledge documents
# What to ask client: OpenAI API Key or Google Gemini API Key
OPENAI_API_KEY=sk-your_openai_api_key_here
# or
GEMINI_API_KEY=your_gemini_api_key_here